# Salin ke backend/.env (dev lokal) atau .env di root (docker compose), lalu isi yang dibutuhkan.
# Semua kredensial opsional: konektor tanpa kredensial otomatis nonaktif, mode demo tetap jalan.

DATABASE_URL=sqlite:///./lacak.db
TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost:5173

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# X API v2 (Bearer token app; butuh tier berbayar untuk membaca timeline) — https://developer.x.com
X_BEARER_TOKEN=

# Instagram Graph API (Business Discovery): token Meta + ID akun IG Business milik Anda
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
GRAPH_API_VERSION=v21.0

# Threads API (izin threads_profile_discovery) — https://developers.facebook.com/docs/threads
THREADS_ACCESS_TOKEN=

# AI (Claude) untuk riset web publik, analisis afiliasi, dan ringkasan laporan
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_WEB_SEARCH_MAX_USES=8

# Jumlah maksimum aktivitas yang diambil per akun per pengumpulan
ACTIVITY_LIMIT=200
